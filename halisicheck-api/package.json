    "dotenv": "^17.4.2",
    "exifr": "^7.1.3",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^6.0.0",
    "mammoth": "^1.12.2",
    "multer": "^2.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
