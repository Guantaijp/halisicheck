# ---------------------------------------------------------------------------
# HalisiCheck API — copy to .env and fill in.
# App-level variables are prefixed HALISI_; vendor credentials keep their
# documented names.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HALISI_BASE_URL=http://localhost:3000

# --- Datastores (docker-compose.yml provides both) -------------------------
DATABASE_URL=postgres://halisi:halisi@localhost:5433/halisicheck
REDIS_URL=redis://localhost:6380
HALISI_DB_LOGGING=false

# --- Auth ------------------------------------------------------------------
# Required in production; falls back to a dev-only value otherwise.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
HALISI_JWT_SECRET=
HALISI_JWT_EXPIRES_IN=7d

# --- Mistral ---------------------------------------------------------------
# Without this the API still runs: ingestion, queuing, job history and image
# metadata inspection all work. The LLM judge, rewrites and image/video
# classification do not. GET /health reports which of these are live.
MISTRAL_API_KEY=
# Model availability is tier-dependent. mistral-large-latest returns
# 403 tier_not_allowed on lower tiers, and mistral-medium/small return 429
# there. ministral-8b-latest is verified working for both text and vision.
# Raise these on a tier that permits it.
HALISI_MISTRAL_TEXT_MODEL=ministral-8b-latest
HALISI_MISTRAL_VISION_MODEL=ministral-8b-latest
HALISI_MISTRAL_MAX_INPUT_CHARS=24000

# --- Storage ---------------------------------------------------------------
STORAGE_DRIVER=local
HALISI_STORAGE_ROOT=./storage
HALISI_MAX_UPLOAD_BYTES=104857600

# --- Video -----------------------------------------------------------------
# ffmpeg and ffprobe must be installed and runnable. Bare names resolve from
# PATH; set absolute paths if they are installed somewhere else.
HALISI_FFMPEG_PATH=ffmpeg
HALISI_FFPROBE_PATH=ffprobe
HALISI_FRAME_INTERVAL_SECONDS=2
HALISI_MAX_FRAMES=25

# --- Detection thresholds --------------------------------------------------
# Score at or above which a span is surfaced for review, and below which it is
# not flagged at all.
HALISI_REVIEW_THRESHOLD=70
HALISI_NOTICE_THRESHOLD=40

# --- CORS ------------------------------------------------------------------
# Comma-separated origins. Left open in development when unset; always set
# this in production.
HALISI_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
